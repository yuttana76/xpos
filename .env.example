DEBUG=True
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=

# --- QR self-order over LAN (docker-compose.yml) ---
# By default this stack only works from the same machine (localhost) — a customer's
# phone can never reach "localhost" (it resolves to the phone itself), so QR self-order
# will fail with "site can't be reached" unless you set these to this machine's LAN IP,
# e.g. 192.168.1.48 (find yours with `ipconfig getifaddr en0` / `ipconfig` / `hostname -I`):
#   ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.48
#   CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://192.168.1.48:3000
#   NEXT_PUBLIC_API_BASE_URL=http://192.168.1.48:8080
# Then also set "URL สำหรับลูกค้าสแกน QR สั่งอาหารเอง" at /setup to http://192.168.1.48:3000
# (or leave it blank and just open the staff POS itself via the LAN IP instead of localhost —
# either is enough, you don't need both).
NEXT_PUBLIC_API_BASE_URL=

POSTGRES_DB=xpos
POSTGRES_USER=xpos
POSTGRES_PASSWORD=xpos
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Store → Cloud sync (docker-compose.yml only — this file's deployment runs as a
# store-local stack; leave CLOUD_API_URL/CLOUD_SYNC_KEY blank on the cloud deployment
# itself. See spec-xpost-gemini.md §17.) ---
# Public URL of the cloud deployment (docker-compose.prod.yml), e.g. https://xpos.example.com
CLOUD_API_URL=
# Generate on the cloud deployment with:
#   docker compose -f docker-compose.prod.yml run --rm backend python manage.py generate_store_sync_key <store_code>
# then paste the printed "store_code:secret" value here.
CLOUD_SYNC_KEY=
# How often (seconds) this store pushes/pulls to the cloud. Default 7200 = 2 hours.
SYNC_INTERVAL_SECONDS=7200
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
# DB 1 (separate from Celery above) — Django's cache framework, used by DRF's pin-login
# rate-limit throttle. Must be a shared cache, not per-process, so the limit is correct
# across multiple backend workers.
DJANGO_CACHE_URL=redis://redis:6379/1

# --- Production only (docker-compose.prod.yml) ---
# In production, set DEBUG=False and point ALLOWED_HOSTS / CORS_ALLOWED_ORIGINS /
# CSRF_TRUSTED_ORIGINS at your real domain instead of localhost, e.g.:
#   ALLOWED_HOSTS=xpos.example.com
#   CORS_ALLOWED_ORIGINS=https://xpos.example.com
#   CSRF_TRUSTED_ORIGINS=https://xpos.example.com
# Public domain served over HTTPS, e.g. xpos.example.com
DOMAIN_NAME=xpos.example.com
# Email used for Let's Encrypt expiry notices
CERTBOT_EMAIL=admin@example.com
# Base URL the frontend calls the API on (public HTTPS URL, proxied by nginx)
NEXT_PUBLIC_API_BASE_URL=https://xpos.example.com
