DEBUG=True
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=

POSTGRES_DB=xpos
POSTGRES_USER=xpos
POSTGRES_PASSWORD=xpos
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Production only (docker-compose.prod.yml) ---
# In production, set DEBUG=False and point ALLOWED_HOSTS / CORS_ALLOWED_ORIGINS /
# CSRF_TRUSTED_ORIGINS at your real domain instead of localhost, e.g.:
#   ALLOWED_HOSTS=xpos.example.com
#   CORS_ALLOWED_ORIGINS=https://xpos.example.com
#   CSRF_TRUSTED_ORIGINS=https://xpos.example.com
# Public domain served over HTTPS, e.g. xpos.example.com
DOMAIN_NAME=xpos.example.com
# Email used for Let's Encrypt expiry notices
CERTBOT_EMAIL=admin@example.com
# Base URL the frontend calls the API on (public HTTPS URL, proxied by nginx)
NEXT_PUBLIC_API_BASE_URL=https://xpos.example.com
